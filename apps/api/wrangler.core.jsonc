{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "margin-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ENV": "production", "AUTH_MODE": "link", "X_SYNC_ENABLED": "false", "X_INBOX_PROCESSING_ENABLED": "false" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "services": [{ "binding": "PREVIEW", "service": "margin-preview" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "margin-reader", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" },
    { "binding": "AUTH_DB", "database_name": "margin-auth", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "auth-migrations" }
  ],
  "observability": { "enabled": false }
}

# Copy to .env.x.local (ignored). OAuth 2.0 confidential Web app credentials.
# Register http://127.0.0.1:47321/oauth/x/callback as the exact callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Absolute free-credit deadline. Missing, invalid or expired blocks paid reads.
X_FREE_STOP_AT=2000-01-01T00:00:00Z
# Optional: the developer app owner's X handle, without @.
# Empty/mismatched handle uses conservative standard post pricing in the budget.
X_OWNER_HANDLE=
